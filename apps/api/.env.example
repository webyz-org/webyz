NODE_ENV=development
PORT=3042
LOG_LEVEL=info

# Which upstream hops may set the client address: a hop count (1 for one
# reverse proxy), a comma list of addresses or CIDRs, or false for direct
# connections. Required in production; the server refuses to boot without it.
TRUST_PROXY=false

# Postgres (docker-compose maps host 5442 -> container 5432)
DATABASE_URL=postgresql://postgres:password@localhost:5442/webyz?schema=public

# ClickHouse (HTTP interface)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=webyz_analytics

# Redis (docker-compose maps host 6382 -> container 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6382

# Dashboard SPA and marketing site
FRONTEND_URL=http://localhost:3041
MARKETING_URL=http://localhost:3040
APP_URL=http://localhost:3041
# Comma separated. Defaults to FRONTEND_URL + MARKETING_URL when unset.
# CORS_ORIGINS=http://localhost:3041,http://localhost:3040

# open lets anyone sign up (the hosted product). Anything else allows only the
# first account, then closes signups (the self-host default).
REGISTRATION=open

# 64 hex characters (32 bytes) for AES-256-GCM at rest, used for Search
# Console refresh tokens. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Drop events whose page hostname is not the site's domain, a subdomain of it,
# or localhost. "off" for setups that serve one site from many hosts.
INGEST_HOSTNAME_CHECK=on

# MaxMind GeoLite2 (optional; geo fields stay empty without it)
MAXMIND_LICENSE_KEY=

# Google OAuth (optional; the button is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3042/api/v1/users/auth/google/callback
# Google Search Console integration reuses the same OAuth client. Enable the
# "Google Search Console API" in the Google Cloud project and register this
# second redirect URI on the client. Defaults to the login redirect's origin
# + /api/v1/gsc/callback when unset.
GSC_REDIRECT_URI=http://localhost:3042/api/v1/gsc/callback

# Paddle Billing (optional; billing degrades to the free plan when unset).
# Paid plans are purchasable only when the API key and the client token are
# both set: the first manages subscriptions, the second opens checkout.
# Read apps/api/docs/billing-runbook.md before pointing this at a live account.
#
# pdl_sdbx_apikey_... for sandbox, pdl_live_apikey_... for live.
PADDLE_API_KEY=
# Client-side token, test_... or live_.... Public by design: the API serves it
# to the dashboard so checkout can open.
PADDLE_CLIENT_TOKEN=
# The notification destination's secret key, pdl_ntfset_.... Point the
# destination at http://localhost:3042/api/v1/paddle/webhook in development.
PADDLE_WEBHOOK_SECRET=
# sandbox or production. Defaults from the API key, which carries "sdbx" for
# sandbox keys, so this is only needed to override that.
# PADDLE_ENVIRONMENT=sandbox

# Email. With no provider set, messages are logged to the console instead of
# being sent, which keeps password reset usable in development.
EMAIL_FROM=Webyz <onboarding@resend.dev>
RESEND_API_KEY=
PASSWORD_RESET_TTL_MINUTES=30

# Whether a password signup must confirm its address before it can sign in and
# before its trial starts. "auto" requires it exactly when RESEND_API_KEY is
# set; "required" and "off" are explicit.
EMAIL_VERIFICATION=auto
EMAIL_VERIFICATION_TTL_HOURS=24
