{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "create:env": "node -r fs -e \"fs.copyFileSync('.env.example', '.env', fs.constants.COPYFILE_EXCL)\"",
    "dev": "npx tsx watch src/server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "worker": "npm run build && node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "clickhouse:migrate": "npx tsx scripts/clickhouse/migrate.ts",
    "clickhouse:seed": "npx tsx scripts/clickhouse/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prisma:seed": "tsx prisma/seed.ts",
    "migrate:deploy": "prisma migrate deploy && tsx scripts/clickhouse/migrate.ts && tsx prisma/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=120000 \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/one-line-logger": "^2.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "close-with-grace": "^2.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.0.1",
    "fs-extra": "^11.4.0",
    "ioredis": "^5.9.3",
    "lru-cache": "^11.5.2",
    "maxmind": "^5.0.7",
    "pino": "^9.9.0",
    "tar": "^7.5.22",
    "ua-parser-js": "^2.0.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
