<!--
  Profile overrides for the default user, mounted into
  /etc/clickhouse-server/users.d/. Matches config.xml: no per-query logging,
  and a memory ceiling so one heavy dashboard query cannot take the server
  down on a 4 GB machine.
-->
<clickhouse>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
            <max_memory_usage>2000000000</max_memory_usage>

            <!-- Small-server profile (ClickHouse's own "under 16 GB" advice, as
                 Plausible ships it). Raise max_threads on a bigger machine
                 if dashboards feel slow. -->
            <max_threads>1</max_threads>
            <max_block_size>8192</max_block_size>
            <max_download_threads>1</max_download_threads>
            <input_format_parallel_parsing>0</input_format_parallel_parsing>
            <output_format_parallel_formatting>0</output_format_parallel_formatting>
        </default>
    </profiles>
</clickhouse>
