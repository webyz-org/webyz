# infra/hosted/environment: the hosted deployment's settings. Copy to
# infra/hosted/environment on the server and fill in. Never committed.
#
# The open-source stack's keys (see infra/setup.sh) plus the hosted ones. The
# README shows how to generate the secrets straight into this file.

# ── hostnames ──────────────────────────────────────────────────────────────
MARKETING_ORIGIN=https://webyz.io
APP_ORIGIN=https://app.webyz.io
API_ORIGIN=https://api.webyz.io
# The open-source compose requires these; the hosted overlay overrides what
# they feed, but they must be set.
DOMAIN=app.webyz.io
BASE_URL=https://app.webyz.io

# ── databases (generated by setup.sh; used only inside the stack) ──────────
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=

# ── product ────────────────────────────────────────────────────────────────
# disabled = only the first account can sign up. open once payments are live.
REGISTRATION=disabled
# 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=
TRUST_PROXY=1
LOG_LEVEL=info

# ── integrations (empty = off) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Webyz <hello@webyz.io>
MAXMIND_LICENSE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Paddle (live account; leave empty until verification passes) ───────────
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=production
PADDLE_IP_ALLOWLIST=on

# ── backups (infra/hosted/backup.sh, nightly from cron) ────────────────────
# Where dumps land on this host. Empty = $HOME/backups/webyz of the user
# running the script. Keep it off the root partition (90% full).
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# rclone remote for the off-host copy, e.g. b2:webyz-backups or s3:webyz-backups.
# Empty = backups exist only on this host.
BACKUP_REMOTE=

# ── images ─────────────────────────────────────────────────────────────────
# Built on this host from the checkout; the registry values are unused but
# the base compose interpolates them.
IMAGE_REGISTRY=webyz-hosted
IMAGE_TAG=latest
